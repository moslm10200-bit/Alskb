{"framework":null,"outputDirectory":"public",
 "rewrites":[{"source":"/api/(.*)","destination":"/api/index.js"}],
 "headers":[{"source":"/(.*)","headers":[
  {"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"},
  {"key":"Content-Security-Policy","value":"default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-ancestors 'none'"}]}]}
